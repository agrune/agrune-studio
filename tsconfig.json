{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "agrune": ["../agrune/src/api.ts"],
      "@agrune/manifest": ["../agrune/packages/manifest/src/index.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "forge.config.ts", "vite.*.config.ts", "forge.env.d.ts"]
}
